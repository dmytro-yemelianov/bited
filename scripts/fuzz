#!/usr/bin/env python3
"""Bounded ASan/coverage-guided fuzzing of bytes, buffers and stream operations."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
REPORTS = ROOT / "verification/reports"
REPORTS.mkdir(parents=True, exist_ok=True)
lock = json.loads((ROOT / "verification/toolchain-lock.json").read_text())["fuzz"]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


binary = Path(shutil.which(lock["runner"]) or "/missing").resolve()
if not binary.is_file() or sha(binary) != lock["binary_sha256"]:
    raise SystemExit("Pinned cargo-fuzz executable missing or changed")
if subprocess.check_output(["cargo", "fuzz", "--version"], text=True).strip() != lock["version"]:
    raise SystemExit("Pinned cargo-fuzz version differs")
command = ["cargo", "+"+lock["rust"], "fuzz", "run", "--sanitizer", lock["sanitizer"], "codec"]
with tempfile.TemporaryDirectory(prefix="vvz-fuzz-corpus-", dir=ROOT/"target") as temporary:
    corpus = Path(temporary)
    for seed in (ROOT/"fuzz/seeds").iterdir():
        shutil.copy2(seed,corpus/seed.name)
    invocation = command + [str(corpus), "--", "-runs="+str(lock["runs"]), "-max_len="+str(lock["max_len"]), "-seed="+str(lock["seed"])]
    env = dict(os.environ, CARGO_NET_OFFLINE="true")
    before = sha(ROOT/"fuzz/Cargo.lock")
    result = subprocess.run(invocation, cwd=ROOT, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    (REPORTS/"fuzz.log").write_text(result.stdout)
    if result.returncode or sha(ROOT/"fuzz/Cargo.lock") != before:
        print(result.stdout)
        raise SystemExit(result.returncode or "Fuzz dependency lock changed")
    if f"Done {lock['runs']} runs" not in result.stdout:
        raise SystemExit("Fuzzer did not finish the configured run count")
record = {"schema":"bited-fuzz/0.1", "status":"configured run count passed with AddressSanitizer",
    "configuration":lock, "invocation":command+["temporary seeded corpus","--","-runs="+str(lock["runs"]),"-max_len="+str(lock["max_len"]),"-seed="+str(lock["seed"])],
    "source_sha256":{str(p.relative_to(ROOT)):sha(p) for p in sorted((ROOT/"src").glob("*.rs"))+
        [ROOT/"fuzz/Cargo.toml",ROOT/"fuzz/Cargo.lock",ROOT/"fuzz/fuzz_targets/codec.rs"]},
    "seed_sha256":{p.name:sha(p) for p in sorted((ROOT/"fuzz/seeds").iterdir())},
    "log_sha256":sha(REPORTS/"fuzz.log"), "minimized_regressions":[],
    "limits":"Finite fuzzing evidence, not a universal proof. No failures were found to minimize."}
(REPORTS/"fuzz.json").write_text(json.dumps(record,indent=2)+"\n")
print("200000 seeded coverage-guided ASan fuzz executions passed")
