#!/usr/bin/env python3
"""Regenerate from pinned Rust inputs; never patch generated Lean definitions."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent


def run(args, **kwargs):
    return subprocess.run(args, cwd=kwargs.pop("cwd", ROOT), check=True, text=True, **kwargs)


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="fail on generated-source drift")
    parser.add_argument("--rust-source", type=Path, help="extract an unpacked Cargo archive instead of workspace Rust")
    parser.add_argument("--report-name", default="extraction.json", help="report filename under verification/reports")
    args = parser.parse_args()
    rust_source = args.rust_source.resolve() if args.rust_source else ROOT
    if Path(args.report_name).name != args.report_name:
        raise SystemExit("Report name must be a filename")
    lock = json.loads((ROOT / "verification/toolchain-lock.json").read_text())
    home = Path(os.environ.get("AENEAS_HOME", ROOT / ".toolchains/aeneas")).resolve()
    for path, expected in [(home, lock["aeneas"]), (home / "charon", lock["charon"])]:
        if not (path / ".git").exists():
            raise SystemExit(f"Missing pinned tool checkout: {path}. Set AENEAS_HOME; see README.md.")
        actual = run(["git", "-C", str(path), "rev-parse", "HEAD"], capture_output=True).stdout.strip()
        if actual != expected:
            raise SystemExit(f"Tool revision mismatch: {path}: {actual} != {expected}")
        dirty = run(["git", "-C", str(path), "status", "--porcelain", "--untracked-files=no"], capture_output=True).stdout
        if dirty:
            raise SystemExit(f"Tool checkout contains modified tracked files: {path}")
    version = run([str(home / "bin/aeneas"), "-version"], capture_output=True).stdout.strip()
    if version != "aeneas " + lock["aeneas"][:8]:
        raise SystemExit(f"Aeneas binary version mismatch: {version}")
    env = dict(os.environ, RUSTUP_TOOLCHAIN=lock["extraction_rust"])
    reports = ROOT / "verification/reports"
    reports.mkdir(parents=True, exist_ok=True)
    (ROOT / "target").mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="vvz-extract-", dir=ROOT / "target") as tmp:
        tmp = Path(tmp)
        command = [str(home / "charon/bin/charon"), "cargo", "--preset=aeneas",
                   "--targets", lock["extraction_target"], "--dest-file", str(tmp / "bited.llbc")]
        for symbol in lock["start_from"]:
            command += ["--start-from", symbol]
        command += ["--", "--lib", "--locked", "--offline"]
        run(command, env=env, cwd=rust_source)
        run([str(home / "bin/aeneas"), "-backend", "lean", "-dest", str(tmp / "lean"),
             "-subdir", "Bited/Generated", "-namespace", "Bited.Generated",
             "-use-lean-modules", "false", "-split-files", "-abort-on-error", "-warnings-as-errors",
             "-no-progress-bar", str(tmp / "bited.llbc")])
        generated = tmp / "lean/Bited/Generated"
        expected = ROOT / "lean/Bited/Generated"
        names = {p.name for p in generated.glob("*.lean")}
        if names != {"Types.lean", "Funs.lean"}:
            raise SystemExit(f"Unexpected generated files or missing external models: {sorted(names)}")
        if args.check and names != {p.name for p in expected.glob("*.lean")}:
            raise SystemExit("Generated model file inventory drift")
        for source in sorted(generated.glob("*.lean")):
            destination = expected / source.name
            if args.check:
                if not destination.exists() or destination.read_bytes() != source.read_bytes():
                    raise SystemExit(f"Generated model drift: {destination.relative_to(ROOT)}; run scripts/regenerate-model")
            else:
                expected.mkdir(parents=True, exist_ok=True)
                destination.write_bytes(source.read_bytes())
        paths = list((ROOT / "src").glob("*.rs")) + list(expected.glob("*.lean"))
        paths += [ROOT / "Cargo.toml", ROOT / "Cargo.lock", ROOT / "verification/toolchain-lock.json"]
        record = {
            "status": "source translation checked; not a refinement proof",
            "inputs_and_model": {str(p.relative_to(ROOT)): digest(p) for p in sorted(paths)},
            "llbc_sha256": digest(tmp / "bited.llbc"),
            "tool_binaries": {name: digest(home / name) for name in
                              ["bin/aeneas", "charon/bin/charon", "charon/bin/charon-driver"]},
            "tools": lock,
        }
        record["rust_source"] = str(rust_source)
        record["rust_inputs_sha256"] = {str(p.relative_to(rust_source)): digest(p) for p in
            sorted((rust_source / "src").glob("*.rs")) + [rust_source / "Cargo.toml", rust_source / "Cargo.lock"]}
        (reports / args.report_name).write_text(json.dumps(record, indent=2) + "\n")
    print("Pinned Rust-to-Lean translation checked" if args.check else "Pinned Rust-to-Lean model regenerated")


if __name__ == "__main__":
    main()
