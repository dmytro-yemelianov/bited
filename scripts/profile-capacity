#!/usr/bin/env python3
"""Repeated capacity specialization experiments; production sources unchanged."""
import datetime
import hashlib
import json
import os
from pathlib import Path
import platform
import subprocess

ROOT = Path(__file__).resolve().parent.parent
PACKAGE = ROOT / 'verification/performance'
REPORTS = ROOT / 'verification/reports'
REPORTS.mkdir(exist_ok=True)
for key in ['RUSTFLAGS', 'CARGO_ENCODED_RUSTFLAGS', 'CARGO_PROFILE_RELEASE_OPT_LEVEL',
            'CARGO_PROFILE_RELEASE_LTO', 'CARGO_PROFILE_RELEASE_OVERFLOW_CHECKS']:
    if os.environ.get(key):
        raise SystemExit(f'Unset {key} for matched settings')

def run(command):
    return subprocess.check_output(command, cwd=ROOT, text=True)

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

runs = []
for repetition in range(3):
    runs.append(json.loads(run(['cargo', 'run', '--manifest-path', str(PACKAGE/'Cargo.toml'),
                         '--release', '--locked', '--offline', '--bin', 'capacity'])))
    print(f'Completed matched measurement run {repetition + 1}/3', flush=True)
report = {'schema':'varint-capacity-study/0.1', 'runs':runs,
          'total_checks':sum(r['checks'] for r in runs)}
report['timestamp_utc'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
report['host'] = platform.platform()
report['cpu'] = run(['sysctl', '-n', 'machdep.cpu.brand_string']).strip()
report['rustc'] = run(['rustc', '-Vv']).strip()
report['git_commit'] = run(['git', 'rev-parse', 'HEAD']).strip()
report['working_tree_dirty'] = bool(run(['git', 'status', '--porcelain']).strip())
report['load_average_after_timing'] = os.getloadavg()
report['flags'] = {'opt_level':3, 'overflow_checks':True, 'lto':False,
                   'debug_info':1, 'target_cpu':'compiler default', 'threads':1}
inputs = [PACKAGE/'Cargo.toml', PACKAGE/'Cargo.lock', PACKAGE/'src/bin/capacity.rs',
          ROOT/'Cargo.toml', ROOT/'Cargo.lock', ROOT/'rust-toolchain.toml', ROOT/'scripts/profile-capacity', *sorted((ROOT/'src').glob('*.rs'))]
report['source_sha256'] = {str(p.relative_to(ROOT)):sha(p) for p in inputs}
binary = PACKAGE/'target/release/capacity'
release = json.loads((REPORTS/'verification.json').read_text())
production = {name:digest for name,digest in release['source_inputs_sha256'].items()
              if name.startswith(('src/', 'lean/', 'tests/')) or name in
              ['Cargo.toml', 'Cargo.lock', 'lakefile.toml', 'lake-manifest.json', 'rust-toolchain.toml']}
if not production or any(sha(ROOT/name) != digest for name,digest in production.items()):
    raise SystemExit('Production inputs differ from frozen verified release; review study scope')
report['production_source_matches_release_commit'] = release['source_commit']
report['production_inputs_sha256'] = production
report['decision_scope'] = 'Supplementary experiment only; candidates are not shipped or Lean-verified'
report['binary_sha256'] = sha(binary)
disassembly = REPORTS/'capacity-disassembly.txt'
disassembly.write_text(run(['xcrun','llvm-objdump','--disassemble','--demangle',str(binary)]))
report['disassembly_sha256'] = sha(disassembly)
profiles=[]
for codec in ['current','fast','required','small']:
    for capacity in ['opaque','known']:
        name=f'capacity-{codec}-{capacity}'
        log=REPORTS/(name+'.log')
        sample=REPORTS/(name+'.sample.txt')
        with log.open('w') as stream:
            process=subprocess.Popen([str(binary),'profile',codec,capacity],cwd=ROOT,
                                     stdout=stream,stderr=stream)
            try:
                result=subprocess.run(['/usr/bin/sample',str(process.pid),'3','1','-file',str(sample)],
                                      cwd=ROOT,capture_output=True,text=True,timeout=15)
                profiles.append({'codec':codec,'capacity':capacity,'return_code':result.returncode,
                    'report':str(sample.relative_to(ROOT)),'sha256':sha(sample) if sample.exists() else None,
                    'log':str(log.relative_to(ROOT)),'tool_output':result.stdout+result.stderr})
            finally:
                if process.poll() is None: process.terminate()
                process.wait(timeout=5)
        print('Collected '+name,flush=True)
if any(p['return_code'] != 0 or p['sha256'] is None for p in profiles):
    raise SystemExit('Sampling failed; inspect logs; no success report written')
report['profiles']=profiles
report['limits']='statistical 1 ms stacks, no PMU/branch-miss counters; shared host; controls modify multiple instruction/layout effects and are not additive cost accounting'
(REPORTS/'capacity-study.json').write_text(json.dumps(report,indent=2)+'\n')
print('Wrote verification/reports/capacity-study.json',flush=True)
